{
  "name": "skladno-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "setup:mac": "bash scripts/setup-mac.sh",
    "db:repair": "node prisma/seed.js --repair",
    "db:migrate:reg": "bash scripts/migrate-to-reg-cloud.sh",
    "cleanup:local-cloud": "node scripts/cleanup-local-after-cloud.mjs",
    "cleanup:hello-audio": "node scripts/cleanup-unused-hello-audio.mjs",
    "cleanup:orphan-audio": "node scripts/cleanup-orphan-s3-audio.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "multer": "^2.0.2",
    "@aws-sdk/client-s3": "^3.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prisma": "^6.16.2",
    "vite": "^6.1.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
